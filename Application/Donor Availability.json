    {
      "parameters": {
        "jsCode": "\nconst donors = $input.all().map(i => i.json);\nconst now = new Date();\nconst resetList = donors.filter(d => {\n  const last = new Date(d.LastUpdated);\n  const diffDays = (now - last) / (1000 * 3600 * 24);\n  return diffDays > 30 && d.Available === 'No';\n});\nreturn resetList.map(d => ({json: {Email: d.Email, Available: 'Yes', LastUpdated: new Date().toISOString()}}));\n                "
