      "parameters": {
        "jsCode": "const donors = $input.all().map((item) => item.json);\nconst requester = $(\"Request Webhook\").all()[0].json.body;\n\nconst eligibleDonors = donors.filter((donor) => {\n  return (\n    donor[\"Blood Group\"] === requester.bloodgroup &&\n    donor.City === requester.city &&\n    donor.Available === \"Yes\"\n  );\n});\n\nreturn eligibleDonors.map((donor) => ({ json: donor }));\n"
      },
