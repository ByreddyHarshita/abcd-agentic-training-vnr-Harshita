    {
      "parameters": {
        "jsCode": "// Get all matched tutors from Filter step\nconst donors = $('Filter Donors').all().map(i => i.json);\n\n// Get the CURRENT tutor's email from the UPDATED Active Request sheet\nlet updatedRequest = null;\ntry {\n  updatedRequest = $('Update Active Request for Next Donor').first()?.json;\n} catch (e) {\n  updatedRequest = null;\n}\n\nif (!updatedRequest) {\n  // Fallback: if update hasn't happened yet, use Store Active Request (first tutor case)\n  const storedRequest = $('Store Active Request').first()?.json;\n  if (!storedRequest) return [];\n  \n  const currentDonorEmail = storedRequest[\"Donor Email\"];\n  const currentIndex = donors.findIndex(t => t.Email === currentDonorEmail);\n  \n  if (currentIndex === -1 || currentIndex >= donors.length - 1) {\n    return [];\n  }\n  \n  return [{json: donors[currentIndex + 1]}];\n}\n\n// Use the UPDATED tutor email (for 2nd, 3rd, etc. rejections)\nconst currentDonorEmail = updatedRequest[\"Donor Email\"];\nconst currentIndex = donors.findIndex(t => t.Email === currentDonorEmail);\n\n// Check if there's a next donor\nif (currentIndex === -1 || currentIndex >= donors.length - 1) {\n  return [];\n}\n\n// Return the next tutor\nconst nextDonor = donors[currentIndex + 1];\nreturn [{json: nextDonor}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
