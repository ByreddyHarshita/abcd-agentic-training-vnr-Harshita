      "parameters": {
        "sendTo": "={{ $json['Donor Email'] }}",
        "subject": "Blood Donation Request",
        "message": "=<p>Dear {{ $json['Donor Name'] }},</p>\n\n<p>We have an urgent blood donation request that matches your blood group <b>{{ $('Request Webhook').first().json.body.bloodgroup }}</b>. Your help is needed.<b></p>\n\n<p><b>Request Details:</b><br>\n- Blood Group: {{ $('Request Webhook').first().json.body.bloodgroup }}<br>\n- Requester Name: {{ $('Request Webhook').first().json.body.RequesterName }}<br>\n- Location: {{ $('Request Webhook').first().json.body.city }}<br>\n- Requester Email: {{ $('Request Webhook').first().json.body.RequesterEmail }}\n</p>\n\n<p>Your Donation could save a life.If you are available to donate, please respond as soon as possible.</p>\n\n<p>\n<a href=\"{{$execution.resumeUrl}}?response=yes\">Yes, I can donate</a><br>\n  <a href=\"{{$execution.resumeUrl}}?response=no\">Sorry, I'm not available</a>\n</p>\n\n<p>Thank you!<br>\nBest regards,<br>\n<b>Blood Donation Management Team</b></p>\n",
        "options": {}
      },
