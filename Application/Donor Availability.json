    },
    {
      "parameters": {
        "jsCode": "let updatedRequest = null;\nlet activeRequest = null;\ntry {\n  updatedRequest = $('Update Active Request for Next Donor').first()?.json;\n} catch (e) {\n  // Node hasn't been executed yet, that's fine\n  updatedRequest = null;\n}\n\n// Get the initial active request (always exists)\ntry {\n  activeRequest = $('Store Active Request').first()?.json;\n} catch (e) {\n  return [];\n}\n\nlet currentDonorEmail, currentDonorName;\n\n// Find all filtered donors once\nconst donors = $('Filter Donors').all().map(i => i.json);\n\nif (updatedRequest && updatedRequest[\"Donor Email\"]) {\n  currentDonorEmail = updatedRequest[\"Donor Email\"];\n  const donor = donors.find(t => t.Email === currentDonorEmail);\n  currentDonorName = donor?.Name || 'Donor';\n  \n} else if (activeRequest && activeRequest[\"Donor Email\"]) {\n  currentDonorEmail = activeRequest[\"Donor Email\"];\n  const donor = donors.find(t => t.Email === currentDonorEmail);\n  currentDonorName = donor?.Name || 'Donor';\n  \n} else {\n  return [];\n}\n\nreturn [{\n  json: {\n    currentDonorEmail: currentDonorEmail,\n    currentDonorName: currentDonorName\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        176
      ],
      "id": "60f6659a-34d7-4420-8b08-86e0cf1a03e5",
      "name": "Get Current Donor Email"
    },
    {
      "parameters": {
        "jsCode": "// Identify which tutor just rejected\nlet rejectedDonorEmail;\n\n// Try to get from Store Active Request (first tutor)\nconst activeRequest = $('Store Active Request').first()?.json;\n\n// Try to get from Update Active Request (subsequent tutors)\nlet updatedRequest = null;\ntry {\n  updatedRequest = $('Update Active Request for Next Donor').first()?.json;\n} catch (e) {\n  updatedRequest = null;\n}\n\nif (updatedRequest && updatedRequest[\"Donor Email\"]) {\n  // Subsequent tutor rejected\n  rejectedDonorEmail = updatedRequest[\"Donor Email\"];\n} else if (activeRequest && activeRequest[\"Donor Email\"]) {\n  // First tutor rejected\n  rejectedDonorEmail = activeRequest[\"Donor Email\"];\n} else {\n  return [];\n}\n\nreturn [{\n  json: {\n    rejectedDonorEmail: rejectedDonorEmail\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
